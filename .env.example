# ═══════════════════════════════════════════
# Kamila WhatsApp Bot Configuration
# ═══════════════════════════════════════════
# Copy this file to .env and edit as needed.
# Never commit .env to version control.

# ── Server ──────────────────────────────
# Port for the web dashboard
PORT=3000

# ── Security ────────────────────────────
# API key for dashboard access (leave blank for dev mode)
# If set, dashboard must send x-api-key header with requests
API_KEY=

# ── Ollama (AI) ─────────────────────────
# URL for the Ollama chat API
OLLAMA_URL=http://localhost:11434/api/chat

# Model name — must be pulled via `ollama pull <model>`
# Examples: qwen2.5-coder:0.5b, llama3.1:8b, mistral:7b
MODEL_NAME=kamila

# Timeout for Ollama requests (ms)
# Increase if using large models (e.g., 60000 for 7B+ models)
AXIOS_TIMEOUT_MS=30000

# ── Rate Limiting ───────────────────────
# Minimum delay between bot replies to the same user (ms)
# Prevents spam if a user sends many messages quickly
RATE_LIMIT_COOLDOWN_MS=2000

# ── Puppeteer (Chromium) ────────────────
# Run Chromium in headless mode (true/false)
# Set to false to see the browser window for debugging
PUPPETEER_HEADLESS=true

# Extra Chromium flags
# Common flags: --no-sandbox, --disable-setuid-sandbox, --disable-dev-shm-usage
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage

# Path to Chromium binary
# Linux: /usr/bin/chromium or /usr/bin/chromium-browser
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROMIUM_PATH=/usr/bin/chromium

# ── Database ─────────────────────────────
# Path to SQLite database file (auto-created on first run)
DB_PATH=./kamila.db
