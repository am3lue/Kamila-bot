# ═══════════════════════════════════════════
# Kamila configuration. Copy to .env and fill in the REQUIRED values.
# Never commit .env.
# ═══════════════════════════════════════════

# ── Server ──────────────────────────────
PORT=3000
NODE_ENV=production
# Set to 1 when running behind a reverse proxy (nginx, Caddy, Cloudflare, a PaaS router).
TRUST_PROXY=
# debug | info | warn | error   (default: info in production)
LOG_LEVEL=
# Optional: also append logs to this file (stdout is always used).
LOG_FILE=

# ── Sign-in: Tausi Auth (REQUIRED) ──────
# Create a project at https://auth.tausi.app. Under Allowed origins add your dashboard
# origin, and under Redirect URLs add <origin>/login.html.
TAUSI_URL=https://auth.tausi.app
TAUSI_PUBLISHABLE_KEY=pk_...
TAUSI_SECRET_KEY=sk_...
# Optional: Tausi webhook secret. Point a Tausi webhook at <origin>/webhooks/tausi so a
# deleted Tausi user's WhatsApp projects are removed too.
TAUSI_WEBHOOK_SECRET=

# Owners also get the Kamila bot pages and the "Kamila" number. A user is an owner if their
# Tausi role is "admin", or their VERIFIED email / phone is listed here (comma-separated).
OWNER_EMAILS=
OWNER_PHONES=

# ── Database: Supabase (REQUIRED) ───────
# Run every file in supabase/migrations/ in order first.
SUPABASE_URL=https://your-project.supabase.co
# Service-role key, server only. RLS keeps the anon/authenticated roles out of every table.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI: Google Gemini ───────────────────
# For AI chatbot projects and the Kamila bot. Get a key at https://aistudio.google.com/apikey
# (projects can also bring their own key in the dashboard).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Secrets at rest ─────────────────────
# Long random strings, e.g. `openssl rand -hex 32`. If empty they are generated and stored in
# Supabase; setting them here keeps them outside the database.
ENCRYPTION_KEY=
OTP_PEPPER=

# ── Limits ──────────────────────────────
# WhatsApp numbers on this server (each runs a Chromium, ~200 MB RAM) and per signed-in user.
MAX_SESSIONS=10
MAX_SESSIONS_PER_USER=2
# Per project: OTP codes + sent messages per minute, Chat API messages per minute, widget messages per day.
SESSION_RATE_LIMIT_PER_MIN=30
CHAT_RATE_LIMIT_PER_MIN=60
WIDGET_MAX_MESSAGES_PER_DAY=1000
# POST /v1/messages: max messages per minute to the same phone number
SEND_PER_RECIPIENT_PER_MIN=5
# Only for local testing: allow webhooks / answer URLs on localhost or private networks.
ALLOW_PRIVATE_WEBHOOKS=

# ── OTP ─────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5

# ── WhatsApp (Chromium) ─────────────────
# Linux: /usr/bin/chromium or /usr/bin/google-chrome-stable
CHROMIUM_PATH=/usr/bin/chromium
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage
# Where WhatsApp logins are kept. Must persist across restarts/deploys.
WHATSAPP_AUTH_DIR=./.wwebjs_auth

# ── Kamila bot ──────────────────────────
# SQLite file for the Kamila bot's chats, tasks and memory. Must persist.
DB_PATH=./kamila.db
# Minimum gap between Kamila replies to the same contact (ms).
RATE_LIMIT_COOLDOWN_MS=2000
# Optional: lets scripts call the Kamila bot's /api routes with `x-api-key: <API_KEY>`.
API_KEY=
